# Copy to .env.local if a future build step injects these.
# The running app does not read this file. It reads window.DUO_AUTH_CONFIG
# in index.html. Do not commit real client ids. Never put a client secret here.
#
# Booleans match the committed defaults: Apple off, Google web sign-in on.

DUO_APPLE_ENABLED=false
DUO_GOOGLE_ENABLED=true
# Temporary iPhone testing only, before Sign in with Apple exists.
# Leave false for an App Store build. Guideline 4.8.
DUO_ALLOW_GOOGLE_WITHOUT_APPLE=false

# Apple Services ID (web and Android). Not the .p8 private key.
DUO_APPLE_CLIENT_ID=

# Google Cloud OAuth client ids. The web client id is also what Android native
# sign-in sends. The iOS client id is the iOS OAuth client. The Android client
# id is the package-name client (SHA-1). It is recorded for the Cloud Console
# and for Supabase's extra client ids. The plugin itself asks for the web id
# on Android and the iOS id on iPhone.
DUO_GOOGLE_WEB_CLIENT_ID=
DUO_GOOGLE_IOS_CLIENT_ID=
DUO_GOOGLE_ANDROID_CLIENT_ID=
